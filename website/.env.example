# UUID of the clinic that owns public demo/contact submissions.
# Set only after the bootstrap clinic migration has created the clinic.
PUBLIC_INTAKE_CLINIC_ID=

# JSON mapping of trusted telephony destination numbers to clinic UUIDs.
# Example: {"+15551234567":"00000000-0000-4000-8000-000000000000"}
TELEPHONY_CLINIC_PHONE_MAP={}

# JSON mapping of clinic UUIDs to India handoff numbers in E.164 format.
TELEPHONY_HANDOFF_PHONE_MAP={}

# Trusted public origin used when validating Twilio signatures behind Vercel/reverse proxies.
# Example: https://app.patientpilot.ai
TWILIO_WEBHOOK_BASE_URL=

# Server-only secret for the scheduled webhook-delivery retention endpoint.
WEBHOOK_CLEANUP_CRON_SECRET=

# Server-only durable Identity session signing secrets. Use distinct, high-entropy
# values in staging and production.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Server-only transactional email delivery and webhook/retry verification.
RESEND_API_KEY=
TRANSACTIONAL_EMAIL_FROM=
RESEND_WEBHOOK_SECRET=
EMAIL_RETRY_CRON_SECRET=

# Public application origin used for Supabase password-recovery redirects.
# Use https outside local development and do not include a path, query, or fragment.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Required for Vercel Preview deployments. Pin the non-secret Supabase project
# reference expected by that deployment (for staging: tgpcgyuujaklgepknucd).
SUPABASE_EXPECTED_PROJECT_REF=
OPENAI_API_KEY=
OPENAI_MODEL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Public product defaults; never place secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_APP_NAME=PatientPilot AI
NEXT_PUBLIC_API_VERSION=v1
NEXT_PUBLIC_DEFAULT_COUNTRY=IN
NEXT_PUBLIC_DEFAULT_LOCALE=en-IN
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Kolkata
